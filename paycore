def hash_password(p: str) -> str:
    salt = secrets.token_hex(16)
    dk = hashlib.pbkdf2_hmac("sha256", p.encode("utf-8"), salt.encode(), 200_000)
    return f"pbkdf2_sha256$200000${salt}${dk.hex()}"

def verify_password(p: str, h: str) -> bool:
    try:
        _, it_s, salt, hexdk = h.split("$")
        dk = hashlib.pbkdf2_hmac("sha256", p.encode("utf-8"), salt.encode(), int(it_s))
        return secrets.compare_digest(dk.hex(), hexdk)
    except: return False

def quantize_amount(v: Decimal) -> Decimal:
    if not isinstance(v, Decimal): v = Decimal(str(v))
    return v.quantize(Decimal("0.01"), rounding=ROUND_DOWN)

