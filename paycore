def quantize_amount(v: Any) -> Decimal:
    s = str(v).strip().lower().replace(',', '.')
    with localcontext() as ctx:
        ctx.prec=38; ctx.rounding=ROUND_HALF_UP
        return Decimal(s).quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP)

def generate_hmac(data: str, secret: str) -> str:
    return hmac.new(secret.encode(), data.encode(), hashlib.sha256).hexdigest()

def device_fp(req: Request) -> str:
    ua = req.headers.get("user-agent","")[:200]
    ip = req.client.host if req.client else "unknown"
    lang = req.headers.get("accept-language","")[:50]
    tz = req.headers.get("sec-ch-ua-platform","")[:30]
    raw = f"{ua}|{ip}|{lang}|{tz}|v8.2"
    return hashlib.sha256(raw.encode()).hexdigest()[:32]

def device_fp_v2(req: Request) -> Dict[str, str]:
    ua = req.headers.get("user-agent","")[:200]
    ip = req.client.host if req.client else "unknown"
    lang = req.headers.get("accept-language","")[:50]
    platform = req.headers.get("sec-ch-ua-platform","unknown")[:30]
    mobile = req.headers.get("sec-ch-ua-mobile","?0")[:10]
    raw = f"{ua}|{ip}|{lang}|{platform}|{mobile}|v8.2"
    fp_hash = hashlib.sha256(raw.encode()).hexdigest()
    return {"fp_hash": fp_hash[:32], "fp_full": fp_hash, "platform": platform, "ip": ip}

