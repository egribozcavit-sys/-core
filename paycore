@app.post("/api/demo/deposits", status_code=201)
def deposit(payload:DepositRequest, req:Request, cu:Annotated[User,Depends(current_user)], db:Annotated[Session,Depends(get_db)]):
    rate_limit(req,"deposit",20,60)
    require_kyc(cu)
    dup=db.scalar(select(Transaction).where(Transaction.user_id==cu.id, Transaction.idempotency_key==payload.idempotency_key))
    if dup: return dup
    acc=db.scalar(select(Account).where(Account.user_id==cu.id, Account.currency==payload.currency, Account.is_active.is_(True)).with_for_update())
    if not acc: raise HTTPException(status_code=404, detail="Cüzdan yok")
    acc.balance=quantize_amount(Decimal(acc.balance)+payload.amount); acc.version+=1
    tx=Transaction(reference=f"DEP-{secrets.token_hex(10).upper()}", type=TxType.DEPOSIT.value, account_id=acc.id, amount=payload.amount, currency=payload.currency, balance_after=acc.balance, user_id=cu.id, idempotency_key=payload.idempotency_key)
    db.add(tx); db.commit(); db.refresh(tx); return tx

@app.post("/api/transfers", status_code=201)
def transfer(payload:TransferRequest, req:Request, cu:Annotated[User,Depends(current_user)], db:Annotated[Session,Depends(get_db)]):
    rate_limit(req,"transfer",10,60)
    require_kyc(cu)
    dup=db.scalar(select(Transaction).where(Transaction.user_id==cu.id, Transaction.idempotency_key==payload.idempotency_key))
    if dup: return dup
    if payload.to_email.lower()==cu.email.lower(): raise HTTPException(status_code=400, detail="Kendine yasak")
    if not aml_check(payload.amount, payload.currency): raise HTTPException(status_code=403, detail="AML blok")
    recipient=db.scalar(select(User).where(User.email==payload.to_email.lower(), User.status==UserStatus.ACTIVE.value))
    if not recipient: raise HTTPException(status_code=404, detail="Alıcı yok")
    sender_acc=db.scalar(select(Account).where(Account.user_id==cu.id, Account.currency==payload.currency, Account.is_active.is_(True)).with_for_update())
    recv_acc=db.scalar(select(Account).where(Account.user_id==recipient.id, Account.currency==payload.currency, Account.is_active.is_(True)).with_for_update())
    if not sender_acc or not recv_acc: raise HTTPException(status_code=404, detail="Cüzdan yok")
    if Decimal(sender_acc.balance)<payload.amount: raise HTTPException(status_code=400, detail="Yetersiz")
    today_start=datetime.now(timezone.utc).replace(hour=0,minute=0,second=0,microsecond=0)
    total_today=db.scalar(select(func.coalesce(func.sum(Transaction.amount),0)).where(Transaction.account_id==sender_acc.id, Transaction.type==TxType.TRANSFER_OUT.value, Transaction.created_at>=today_start)) or Decimal("0")
    if Decimal(str(total_today))+payload.amount>DAILY_LIMIT.get(payload.currency, MAX_AMT): raise HTTPException(status_code=400, detail="Limit aşıldı")
    group_ref=f"TRF-{secrets.token_hex(8).upper()}"
    sender_acc.balance=quantize_amount(Decimal(sender_acc.balance)-payload.amount); recv_acc.balance=quantize_amount(Decimal(recv_acc.balance)+payload.amount)
    sender_acc.version+=1; recv_acc.version+=1
    out_tx=Transaction(reference=f"OUT-{secrets.token_hex(10).upper()}", group_reference=group_ref, type=TxType.TRANSFER_OUT.value, account_id=sender_acc.id, counterparty_account_id=recv_acc.id, amount=payload.amount, currency=payload.currency, balance_after=sender_acc.balance, user_id=cu.id, idempotency_key=payload.idempotency_key)
    in_tx=Transaction(reference=f"IN-{secrets.token_hex(10).upper()}", group_reference=group_ref, type=TxType.TRANSFER_IN.value, account_id=recv_acc.id, counterparty_account_id=sender_acc.id, amount=payload.amount, currency=payload.currency, balance_after=recv_acc.balance, user_id=recipient.id, idempotency_key=f"{payload.idempotency_key}-IN")
    db.add_all([out_tx, in_tx]); db.commit(); db.refresh(out_tx); return out_tx