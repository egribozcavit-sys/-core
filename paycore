bearer_scheme=HTTPBearer(auto_error=False)
def get_db():
    db=SessionLocal()
    try: yield db
    finally: db.close()

def is_jti_revoked(db: Session, jti: str)->bool:
    if not jti: return False
    return db.get(RevokedToken, jti) is not None

def revoke_jti(db: Session, jti: str, uid: str, exp_ts: Optional[float])->bool:
    if not jti: return False
    try:
        if is_jti_revoked(db, jti): return False
        exp = datetime.fromtimestamp(exp_ts, tz=timezone.utc) if exp_ts else utc_now()+timedelta(days=30)
        db.add(RevokedToken(jti=jti, user_id=uid, expires_at=exp)); db.commit(); return True
    except IntegrityError: db.rollback(); return False

def create_token(uid: str, typ: str, delta: timedelta)->str:
    now=datetime.now(timezone.utc)
    payload={"sub":uid, "type":typ, "iat":int(now.timestamp()), "exp":int((now+delta).timestamp()), "jti":secrets.token_urlsafe(24)}
    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALG)

def create_access_token(uid: str): return create_token(uid, "access", timedelta(minutes=ACCESS_MIN))
def create_refresh_token(uid: str): return create_token(uid, "refresh", timedelta(days=REFRESH_DAYS))

def current_user(creds: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)], db: Annotated[Session, Depends(get_db)])->User:
    if not creds: raise HTTPException(status_code=401, detail="Auth gerekli", headers={"WWW-Authenticate":"Bearer"})
    try: payload=jwt.decode(creds.credentials, JWT_SECRET, algorithms=[JWT_ALG])
    except JWTError: raise HTTPException(status_code=401, detail="Geçersiz token", headers={"WWW-Authenticate":"Bearer"})
    if payload.get("type")!="access": raise HTTPException(status_code=401, detail="Geçersiz access token")
    if is_jti_revoked(db, payload.get("jti","")): raise HTTPException(status_code=401, detail="Oturum iptal")
    user=db.get(User, payload.get("sub"))
    if not user or user.status==UserStatus.CLOSED.value: raise HTTPException(status_code=401, detail="Kullanıcı yok")
    return user

def fraud_ai_ultra(amount: Decimal, fp: Optional[str], geo: Optional[str], daily_total: Decimal, velocity: int) -> tuple[int, str]:
    score=0
    if amount>Decimal("50000"): score+=30
    if amount>Decimal("500000"): score+=30
    if not fp: score+=20
    if daily_total>Decimal("1000000"): score+=20
    if velocity>10: score+=15
    if geo and geo not in ("TR","US","GB","JP"): score+=10
    score=min(score,100)
    st=FraudStatus.CLEAN.value if score<40 else FraudStatus.FLAGGED.value if score<80 else FraudStatus.BLOCKED.value
    return score, st

def audit_hmac(action: str, uid: Optional[str]=None, req: Optional[Request]=None, detail: Optional[str]=None):
    try:
        payload=f"{action}|{uid}|{detail}|{utc_now().isoformat()}"
        sig=generate_hmac(payload, HMAC_SECRET)
        with SessionLocal() as adb:
            adb.add(AuditLog(user_id=uid, action=action, ip_address=req.client.host if req and req.client else None, user_agent=req.headers.get("user-agent","")[:255] if req else None, detail=detail[:500] if detail else None, hmac_signature=sig)); adb.commit()
    except: pass

def send_webhook_background(outbox_id: str):
    try:
        with SessionLocal() as db:
            ob=db.get(Outbox, outbox_id)
            if not ob or not ob.webhook_url: return
            sig=generate_hmac(ob.payload, WEBHOOK_SECRET)
            audit_hmac("webhook_sent", detail=f"{ob.event_type} -> {ob.webhook_url} sig={sig[:10]} retry={ob.retry_count}")
    except: pass

def check_daily_limit(account_id: str, amount: Decimal, db: Session) -> bool:
    today_start=datetime.now(timezone.utc).replace(hour=0,minute=0,second=0,microsecond=0)
    today_out=db.scalars(select(Transaction.amount).where(Transaction.account_id==account_id, Transaction.type==TxType.TRANSFER_OUT.value, Transaction.created_at>=today_start)).all()
    total=sum([Decimal(str(a)) for a in today_out], Decimal("0"))
    return (total + amount) <= DAILY_LIMIT.get("TRY", MAX_AMT)

def verify_totp(secret: str, code: str) -> bool:
    try:
        import hmac as _hmac, struct, time as _time
        key=base64.b32decode(secret.upper()+"="*((8-len(secret)%8)%8))
        counter=int(_time.time())//30
        msg=struct.pack(">Q", counter)
        h=_hmac.new(key, msg, hashlib.sha1).digest()
        o=h[19]&15
        c=(struct.unpack(">I", h[o:o+4])[0] & 0x7fffffff) % 1000000
        return f"{c:06d}"==code
    except: return False

