        try: return bcrypt.checkpw(p.encode()[:72], h.encode())
        except: return False

def quantize_amount(v: Any) -> Decimal:
    if v is None: raise ValueError("amount_null")
    if isinstance(v, float) and (math.isnan(v) or math.isinf(v)): raise ValueError("nan_inf_banned")
    s = str(v).strip().lower().replace(',', '.')
    if s in ('nan','inf','-inf','+inf','infinity','-infinity',''): raise ValueError("nan_inf_banned")
    with localcontext() as ctx:
        ctx.prec=28; ctx.rounding=ROUND_HALF_UP
        d=Decimal(s)
        if not d.is_finite() or d.is_nan(): raise ValueError("nan_inf")
        return d.quantize(Decimal("0.01"), rounding=ROUND_HALF_UP)

