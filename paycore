@app.post("/api/auth/login")
def login(payload: LoginRequest, req: Request, db: Annotated[Session, Depends(get_db)]):
    rate_limit(req)
    user=db.scalar(select(User).where(User.email==payload.email.lower().strip()))
    if not user: raise HTTPException(status_code=401, detail="Email veya şifre hatalı")
    now=datetime.now(timezone.utc); lu=user.locked_until
    if lu:
        if lu.tzinfo is None: lu=lu.replace(tzinfo=timezone.utc)
        if lu>now: raise HTTPException(status_code=423, detail="Hesap kilitli", headers={"Retry-After": str(int((lu-now).total_seconds()))})
    if not verify_password(payload.password, user.password_hash):
        user.failed_login_attempts+=1
        if user.failed_login_attempts>=5: user.locked_until=now+timedelta(minutes=15)
        db.commit(); raise HTTPException(status_code=401, detail="Email veya şifre hatalı")
    if user.status!=UserStatus.ACTIVE.value: raise HTTPException(status_code=403, detail="Hesap kapalı")
    user.failed_login_attempts=0; user.locked_until=None; db.commit()
    audit("login_ok", uid=user.id, req=req)
    return {"access_token":create_access_token(user.id),"refresh_token":create_refresh_token(user.id),"token_type":"bearer","expires_in":ACCESS_MIN*60}

