# ============= SECURITY =============
pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

def verify_password(plain_password, hashed_password):
    return pwd_context.verify(plain_password, hashed_password)

def get_password_hash(password):
    return pwd_context.hash(password)

def create_access_token(data: dict, expires_delta: Optional[int] = None):
    to_encode = data.copy()
    expire = datetime.utcnow() + (
        timedelta(minutes=expires_delta) if expires_delta else timedelta(minutes=config.ACCESS_TOKEN_EXPIRE_MINUTES)
    )
    to_encode.update({"exp": expire})
    encoded_jwt = jwt.encode(to_encode, config.SECRET_KEY, algorithm=config.ALGORITHM)
    return encoded_jwt

def decode_access_token(token: str):
    try:
        payload = jwt.decode(token, config.SECRET_KEY, algorithms=[config.ALGORITHM])
        return payload
    except jwt.PyJWTError:
        return None

# ============= PERFORMANCE METRICS =============
class PerformanceMetrics:
    def __init__(self):
        # Prometheus metrics
        self.tps_counter = Counter('asas_transactions_per_second', 'Transactions per second')
        self.latency_histogram = Histogram('asas_transaction_latency_seconds', 'Transaction latency')
        self.active_connections = Gauge('asas_active_connections', 'Active connections')
        self.queue_size = Gauge('asas_queue_size', 'Queue size')
        self.error_counter = Counter('asas_errors_total', 'Total errors')
        self.success_counter = Counter('asas_successes_total', 'Total successes')
        
        # Internal metrics
        self.start_time = time.time()
        self.transaction_count = 0
        self.lock = threading.Lock()
        
    def record_transaction(self, latency: float):
        with self.lock:
            self.transaction_count += 1
        self.tps_counter.inc()
        self.latency_histogram.observe(latency)
        
    def record_error(self):
        self.error_counter.inc()
        
    def record_success(self):
        self.success_counter.inc()
        
    def get_stats(self):
        elapsed = time.time() - self.start_time
        with self.lock:
            tps = self.transaction_count / elapsed if elapsed > 0 else 0
        return {
            'total_transactions': self.transaction_count,
            'elapsed_seconds': elapsed,
            'tps': tps
        }

metrics = PerformanceMetrics()

# ============= LOCK-FREE TRANSACTION ENGINE =============
class LockFreeTransactionEngine:
    def __init__(self):
        self.transaction_queue = queue.Queue(maxsize=config.MAX_QUEUE_SIZE)
        self.executor = ThreadPoolExecutor(max_workers=config.THREAD_POOL_SIZE)
        self.batch_processor = BatchProcessor()
        self.running = True
        
    def submit_transaction(self, transaction_data: dict):
        try:
            self.transaction_queue.put_nowait(transaction_data)
            metrics.queue_size.set(self.transaction_queue.qsize())
            return True
        except queue.Full:
            logger.error("Transaction queue is full")
            metrics.record_error()
            return False
            
    def start_processing(self):
        # Start batch processor
        threading.Thread(target=self._process_batches, daemon=True).start()
        logger.info("Lock-free transaction engine started")
        
    def _process_batches(self):
        batch = []
        last_flush = time.time()
        
        while self.running:
            try:
                # Collect transactions
                while len(batch) < config.BATCH_SIZE and not self.transaction_queue.empty():
                    transaction = self.transaction_queue.get_nowait()
                    batch.append(transaction)
                    
                # Process batch if ready or timeout
                if len(batch) >= config.BATCH_SIZE or (batch and time.time() - last_flush > config.FLUSH_INTERVAL):
                    self.executor.submit(self.batch_processor.process_batch, batch.copy())
                    batch.clear()
                    last_flush = time.time()
                    
                time.sleep(0.0001)  # 0.1ms
                
            except Exception as e:
                logger.error(f"Batch processing error: {e}")
                metrics.record_error()
                
    def stop(self):
        self.running = False
        self.executor.shutdown(wait=True)

class BatchProcessor:
    def __init__(self):
        self.retry_queue = queue.Queue()
        
    def process_batch(self, batch: List[dict]):
        start_time = time.time()
        
        try:
            with db_manager.get_session() as session:
                for transaction_data in batch:
                    self._process_single_transaction(session, transaction_data)
                    
                session.commit()
                
            # Update Redis cache
            self._update_redis_cache(batch)
            
            # Record metrics
            latency = time.time() - start_time
            for _ in batch:
                metrics.record_transaction(latency / len(batch))
                metrics.record_success()
                
        except Exception as e:
            logger.error(f"Batch processing failed: {e}")
            metrics.record_error()
            # Retry failed transactions
            for transaction_data in batch:
                self.retry_queue.put(transaction_data)
                
    def _process_single_transaction(self, session, transaction_data: dict):
        # Create transaction record
        transaction = Transaction(
            id=str(uuid.uuid4()),
            sender_account_id=transaction_data['sender_account_id'],
            receiver_account_id=transaction_data['receiver_account_id'],
            amount=transaction_data['amount'],
            currency=transaction_data.get('currency', 'USD'),
            status='processing',
            transaction_type=transaction_data.get('transaction_type', 'transfer'),
            description=transaction_data.get('description'),
            metadata=json.dumps(transaction_data.get('metadata', {}))
        )
        session.add(transaction)
        session.flush()
        
        # Update balances (lock-free with optimistic locking)
        sender_account = session.query(Account).filter(
            Account.id == transaction_data['sender_account_id']
        ).with_for_update().first()
        
        receiver_account = session.query(Account).filter(
            Account.id == transaction_data['receiver_account_id']
        ).with_for_update().first()
        
        if not sender_account or not receiver_account:
            transaction.status = 'failed'
            transaction.failure_reason = 'Account not found'
            transaction.failed_at = datetime.utcnow()
            return
            
        if sender_account.balance < transaction_data['amount']:
            transaction.status = 'failed'
            transaction.failure_reason = 'Insufficient balance'
            transaction.failed_at = datetime.utcnow()
            return
            
        # Update balances
        sender_account.balance -= transaction_data['amount']
        receiver_account.balance += transaction_data['amount']
        receiver_account.updated_at = datetime.utcnow()
        
        # Complete transaction
        transaction.status = 'completed'
        transaction.completed_at = datetime.utcnow()
        
        # Audit log
        audit_log = AuditLog(
            transaction_id=transaction.id,
            user_id=sender_account.user_id,
            action='transaction_completed',
            details=json.dumps({
                'amount': transaction_data['amount'],
                'sender': transaction_data['sender_account_id'],
                'receiver': transaction_data['receiver_account_id']
            })
        )
        session.add(audit_log)
        
    def _update_redis_cache(self, batch: List[dict]):
        redis_client = redis_manager.get_client()
        pipe = redis_client.pipeline()
        
        for transaction_data in batch:
            # Cache account balances
            pipe.hset(f"account:{transaction_data['sender_account_id']}", mapping={
                'balance': transaction_data.get('sender_balance', 0),
                'updated_at': datetime.utcnow().isoformat()
            })
            pipe.hset(f"account:{transaction_data['receiver_account_id']}", mapping={
                'balance': transaction_data.get('receiver_balance', 0),
                'updated_at': datetime.utcnow().isoformat()
            })
            
        pipe.execute()

