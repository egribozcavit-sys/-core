    db.add(user); db.commit(); db.refresh(user)
    for cur in CURRENCIES: db.add(Account(user_id=user.id, currency=cur, balance=Decimal("0.00")))
    db.commit()
    audit("register_ok", uid=user.id, req=req, detail=payload.email)
    return {"access_token": create_access_token(user.id), "refresh_token": create_refresh_token(user.id), "token_type":"bearer", "expires_in": ACCESS_MIN*60}

@app.post("/api/auth/login", response_model=TokenResponse)
def login(payload: LoginRequest, req: Request, db: Annotated[Session, Depends(get_db)]):
    rate_limit(req)
    user = db.scalar(select(User).where(User.email==payload.email))
    if not user: raise HTTPException(status_code=401, detail="Geçersiz")
    if user.locked_until and user.locked_until>utc_now(): raise HTTPException(status_code=423, detail="Kilitli")
    if not verify_password(payload.password, user.password_hash):
        user.failed_login_attempts+=1
        if user.failed_login_attempts>=MAX_FAIL: user.locked_until=utc_now()+timedelta(minutes=LOCK_MIN)
        db.commit(); audit("login_fail", uid=user.id, req=req); raise HTTPException(status_code=401, detail="Geçersiz")
    user.failed_login_attempts=0; user.locked_until=None; db.commit()
    audit("login_ok", uid=user.id, req=req)
    return {"access_token": create_access_token(user.id), "refresh_token": create_refresh_token(user.id), "token_type":"bearer", "expires_in": ACCESS_MIN*60}

