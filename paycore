def is_jti_revoked(db: Session, jti: str)->bool:
    if not jti: return False
    return db.get(RevokedToken, jti) is not None

def revoke_jti(db: Session, jti: str, uid: str, exp_ts: Optional[float])->bool:
    if not jti: return False
    try:
        if is_jti_revoked(db, jti): return False
        exp = datetime.fromtimestamp(exp_ts, tz=timezone.utc) if exp_ts else utc_now()+timedelta(days=30)
        db.add(RevokedToken(jti=jti, user_id=uid, expires_at=exp)); db.commit(); return True
    except IntegrityError: db.rollback(); return False

def create_token(uid: str, typ: str, delta: timedelta)->str:
    now=datetime.now(timezone.utc)
    payload={"sub":uid, "type":typ, "iat":int(now.timestamp()), "exp":int((now+delta).timestamp()), "jti":secrets.token_urlsafe(24)}
    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALG)

def create_access_token(uid: str): return create_token(uid, "access", timedelta(minutes=ACCESS_MIN))
def create_refresh_token(uid: str): return create_token(uid, "refresh", timedelta(days=REFRESH_DAYS))

def current_user(creds: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)], db: Annotated[Session, Depends(get_db)])->User:
    if not creds: raise HTTPException(status_code=401, detail="Auth gerekli", headers={"WWW-Authenticate":"Bearer"})
    try: payload=jwt.decode(creds.credentials, JWT_SECRET, algorithms=[JWT_ALG])
    except JWTError: raise HTTPException(status_code=401, detail="Geçersiz token", headers={"WWW-Authenticate":"Bearer"})
    if payload.get("type")!="access": raise HTTPException(status_code=401, detail="Geçersiz access token")
    if is_jti_revoked(db, payload.get("jti","")): raise HTTPException(status_code=401, detail="Oturum iptal")
    user=db.get(User, payload.get("sub"))
    if not user or user.status==UserStatus.CLOSED.value: raise HTTPException(status_code=401, detail="Kullanıcı yok")
    return user

def fraud_ai_ultra(amount: Decimal, fp: Optional[str], geo: Optional[str], daily_total: Decimal, velocity: int) -> tuple[int, str]:
    score=0
    if amount>Decimal("50000"): score+=30
    if amount>Decimal("500000"): score+=30
    if not fp: score+=20
    if daily_total>Decimal("1000000"): score+=20
    if velocity>10: score+=15
    if geo and geo not in ("TR","US","GB","JP"): score+=10
    score=min(score,100)
    st=FraudStatus.CLEAN.value if score<40 else FraudStatus.FLAGGED.value if score<80 else FraudStatus.BLOCKED.value
    return score, st

def calculate_30d_baseline(user_id: str, db: Session) -> Dict[str, Any]:
    thirty_days_ago = utc_now() - timedelta(days=30)
    txs = db.scalars(select(Transaction).where(
        Transaction.user_id==user_id,
        Transaction.created_at>=thirty_days_ago,
        Transaction.type==TxType.TRANSFER_OUT.value
    )).all()
    if len(txs) < 5:
        return {"has_baseline": False, "reason": "cold_start"}
    daily_counts = Counter([t.created_at.date() for t in txs])
    avg_daily_count = sum(daily_counts.values()) / max(len(daily_counts), 1)
    amounts = [Decimal(str(t.amount)) for t in txs]
    avg_amount = sum(amounts, Decimal("0")) / len(amounts)
    variance = sum((a - avg_amount) ** 2 for a in amounts) / len(amounts)
    std_amount = variance.sqrt() if variance > 0 else Decimal("0.000001")
    geos = [t.geo_country for t in txs if t.geo_country]
    devices = [t.device_fp for t in txs if t.device_fp]
    common_geo = Counter(geos).most_common(1)[0][0] if geos else None
    common_device = Counter(devices).most_common(1)[0][0] if devices else None
    daily_totals = defaultdict(Decimal)
    for t in txs:
        daily_totals[t.created_at.date()] += Decimal(str(t.amount))
    avg_daily_total = sum(daily_totals.values(), Decimal("0")) / max(len(daily_totals), 1)
    return {
        "has_baseline": True,
        "avg_daily_count": Decimal(str(avg_daily_count)),
        "avg_amount": quantize_amount(avg_amount),
        "std_amount": quantize_amount(std_amount),
        "avg_daily_total": quantize_amount(avg_daily_total),
        "common_geo": common_geo,
        "common_device_fp": common_device,
        "last_30d_tx_count": len(txs),
        "daily_counts": daily_counts
    }

def behavioral_ai_check(user_id: str, current_amount: Decimal, current_geo: Optional[str], current_fp: Optional[str], db: Session) -> tuple[int, str, Optional[Dict]]:
    baseline = calculate_30d_baseline(user_id, db)
    if not baseline["has_baseline"]:
        return 0, FraudStatus.CLEAN.value, None
    score = 0
    reasons = []
    today = utc_now().date()
    today_count = db.scalar(select(func.count()).select_from(Transaction).where(
        Transaction.user_id==user_id,
        func.date(Transaction.created_at)==today
    )) or 0
    if Decimal(today_count + 1) > baseline["avg_daily_count"] * Decimal("3") and baseline["avg_daily_count"] > 0:
        score += 40
        reasons.append(f"count_anomaly: 30g ort {baseline['avg_daily_count']:.1f}/gün, bugün {today_count+1} -> agresif")
    if current_amount > baseline["avg_amount"] + (baseline["std_amount"] * 3):
        score += 35
        reasons.append(f"amount_anomaly: 30g ort {baseline['avg_amount']} std {baseline['std_amount']}, şimdi {current_amount}")
    if baseline["common_geo"] and current_geo and current_geo != baseline["common_geo"]:
        geo_change_count = db.scalar(select(func.count()).select_from(Transaction).where(
            Transaction.user_id==user_id,
            Transaction.geo_country==current_geo,
            Transaction.created_at>=utc_now()-timedelta(days=30)
        )) or 0
        if geo_change_count == 0:
            score += 25
            reasons.append(f"geo_anomaly: 30g hep {baseline['common_geo']}, şimdi {current_geo} ilk kez")
    if baseline["common_device_fp"] and current_fp and current_fp != baseline["common_device_fp"]:
        device_change_count = db.scalar(select(func.count()).select_from(Transaction).where(
            Transaction.user_id==user_id,
            Transaction.device_fp==current_fp,
            Transaction.created_at>=utc_now()-timedelta(days=30)
        )) or 0
        if device_change_count == 0:
            score += 20
            reasons.append(f"device_anomaly: 30g aynı fp, şimdi yeni fp {current_fp[:8]}")
    today_total_q = db.scalars(select(Transaction.amount).where(
        Transaction.user_id==user_id,
        func.date(Transaction.created_at)==today
    )).all()
    today_total = sum([Decimal(str(a)) for a in today_total_q], Decimal("0"))
    if baseline["avg_daily_total"] > 0 and today_total + current_amount > baseline["avg_daily_total"] * Decimal("5"):
        score += 30
        reasons.append(f"daily_total_anomaly: 30g ort {baseline['avg_daily_total']}, bugün {today_total + current_amount}")
    detail = {"reasons": reasons, "baseline": baseline, "score": score, "today_count": today_count+1}
    status = FraudStatus.CLEAN.value if score < 30 else FraudStatus.FLAGGED.value if score < 70 else FraudStatus.BLOCKED.value
    return min(score, 100), status, detail

# V8.2 YENİ: Geo Velocity + Device Trust
def calculate_geo_velocity(user_id: str, current_geo: Optional[str], db: Session) -> tuple[int, bool, Optional[Dict]]:
    if not current_geo:
        return 0, False, None
    last_tx = db.scalar(select(Transaction).where(
        Transaction.user_id==user_id,
        Transaction.geo_country.is_not(None)
    ).order_by(Transaction.created_at.desc()))
    if not last_tx or not last_tx.geo_country or last_tx.geo_country == current_geo:
        return 0, False, None
    time_diff = (utc_now() - last_tx.created_at).total_seconds()
    # İmkansız seyahat: TR -> US 10 dakikada?
    # Basit mesafe tahmini: farklı kıta = 8000km
    impossible_threshold = 3600  # 1 saatte farklı ülke = şüpheli
    if time_diff < impossible_threshold and last_tx.geo_country != current_geo:
        # TR -> US 5 dakikada imkansız
        distance_estimate = 8000 if {last_tx.geo_country, current_geo} & {"US","TR","JP","GB"} else 2000
        required_speed = distance_estimate / max(time_diff/3600, 0.1)  # km/h
        if required_speed > 900:  # Uçak hızı 900km/h
            return 50, True, {"from": last_tx.geo_country, "to": current_geo, "time_diff_s": int(time_diff), "required_speed_kmh": int(required_speed), "impossible": True}
        return 20, False, {"from": last_tx.geo_country, "to": current_geo, "time_diff_s": int(time_diff)}
    return 0, False, None

def calculate_device_trust(user_id: str, current_fp: Optional[str], db: Session) -> tuple[int, bool]:
    if not current_fp:
        return 20, False
    trust = db.scalar(select(DeviceTrust).where(
        DeviceTrust.user_id==user_id,
        DeviceTrust.device_fp==current_fp
    ))
    if not trust:
        return 20, False  # Yeni cihaz = düşük güven
    if trust.is_trusted and trust.tx_count > 20:
        return 90, True
    if trust.tx_count > 5:
        return 70, True
    return 40, False

def risk_engine_v2(user_id: str, amount: Decimal, fp: Optional[str], geo: Optional[str], daily_total: Decimal, velocity: int, db: Session) -> Dict[str, Any]:
    fraud_score, fraud_status = fraud_ai_ultra(amount, fp, geo, daily_total, velocity)
    beh_score, beh_status, beh_detail = behavioral_ai_check(user_id, amount, geo, fp, db)
    geo_score, geo_impossible, geo_detail = calculate_geo_velocity(user_id, geo, db)
    device_trust_score, is_trusted_device = calculate_device_trust(user_id, fp, db)
    
    # Combined risk: V8.2 formül
    # Eski: fraud + beh
    # Yeni: fraud*0.3 + beh*0.4 + geo*0.2 + (100-device_trust)*0.1
    device_risk = 100 - device_trust_score
    combined = int(fraud_score*0.3 + beh_score*0.4 + geo_score*0.2 + device_risk*0.1)
    combined = min(combined, 100)
    
    if geo_impossible or combined >= 80:
        risk_level = RiskLevel.CRITICAL.value
    elif combined >= 60:
        risk_level = RiskLevel.HIGH.value
    elif combined >= 35:
        risk_level = RiskLevel.MEDIUM.value
    else:
        risk_level = RiskLevel.LOW.value
    
    reasons = []
    if beh_detail and beh_detail["reasons"]:
        reasons.extend(beh_detail["reasons"])
    if geo_detail and geo_detail.get("impossible"):
        reasons.append(f"impossible_travel: {geo_detail['from']} -> {geo_detail['to']} {geo_detail['time_diff_s']}s içinde {geo_detail.get('required_speed_kmh',0)}km/h gerekli")
    if not is_trusted_device:
        reasons.append(f"untrusted_device: fp {fp[:8] if fp else 'yok'} trust {device_trust_score}")
    
    return {
        "fraud_score": fraud_score,
        "fraud_status": fraud_status,
        "behavioral_score": beh_score,
        "behavioral_status": beh_status,
        "behavioral_detail": beh_detail,
        "geo_velocity_score": geo_score,
        "geo_impossible": geo_impossible,
        "geo_detail": geo_detail,
        "device_trust_score": device_trust_score,
        "is_trusted_device": is_trusted_device,
        "combined_score": combined,
        "risk_level": risk_level,
        "reasons": reasons
    }

def audit_hmac(action: str, uid: Optional[str]=None, req: Optional[Request]=None, detail: Optional[str]=None):
    try:
        # V8.2 chain hash - önceki logun hash'i ile zincirle
        with SessionLocal() as adb:
            last = adb.scalar(select(AuditLog).order_by(AuditLog.created_at.desc()))
            prev_hash = last.hmac_signature if last else "genesis_v8_2"
            payload=f"{action}|{uid}|{detail}|{utc_now().isoformat()}|{prev_hash}"
            sig=generate_hmac(payload, HMAC_SECRET)
            chain = generate_hmac(f"{prev_hash}|{sig}", HMAC_SECRET)
            adb.add(AuditLog(user_id=uid, action=action, ip_address=req.client.host if req and req.client else None, user_agent=req.headers.get("user-agent","")[:255] if req else None, detail=detail[:500] if detail else None, hmac_signature=sig, chain_hash=chain)); adb.commit()
    except Exception as e:
        try:
            with SessionLocal() as adb:
                payload=f"{action}|{uid}|{detail}|{utc_now().isoformat()}"
                sig=generate_hmac(payload, HMAC_SECRET)
                adb.add(AuditLog(user_id=uid, action=action, ip_address=req.client.host if req and req.client else None, user_agent=req.headers.get("user-agent","")[:255] if req else None, detail=detail[:500] if detail else None, hmac_signature=sig)); adb.commit()
        except: pass

