@app.post("/api/real/withdraw", response_model=dict, status_code=201)
def real_withdraw(payload:RealWithdrawRequest, req:Request, cu:Annotated[User,Depends(current_user)], db:Annotated[Session,Depends(get_db)]):
    rate_limit(req)
    q=select(Account).where(Account.user_id==cu.id, Account.currency==payload.currency, Account.is_active.is_(True))
    if not DB_URL.startswith("sqlite"): q=q.with_for_update()
    acc=db.scalar(q)
    if not acc: raise HTTPException(status_code=404, detail="Cüzdan yok")
    if Decimal(acc.balance) < payload.amount: raise HTTPException(status_code=400, detail="Yetersiz bakiye")
    temp_tx = Transaction(reference=f"TEMP-{secrets.token_hex(6)}", type=TxType.REAL_WITHDRAW.value, account_id=acc.id, amount=payload.amount, currency=payload.currency, balance_after=acc.balance, idempotency_key=payload.idempotency_key)
    db.add(temp_tx); db.commit(); db.refresh(temp_tx)
    ai = ai_verify_profile_match(db, cu, temp_tx, req)
    if ai.profile_match_score < 50:
        temp_tx.status=TxStatus.FAILED.value; db.commit()
        raise HTTPException(status_code=403, detail=f"AI profil uyuşmuyor: %{ai.profile_match_score} - Gerçek transfer engellendi: {ai.reasoning}")
    acc.balance=quantize_amount(Decimal(acc.balance)-payload.amount)
    temp_tx.balance_after=acc.balance; temp_tx.status=TxStatus.COMPLETED.value
    adapter = BankFASTAdapter()
    bank_result = adapter.send_fast(payload.iban, payload.amount, payload.currency, payload.description or "A.S.A.S. Pay gerçek transfer")
    movement = RealMoneyMovement(user_id=cu.id, transaction_id=temp_tx.id, iban=payload.iban, amount=payload.amount, currency=payload.currency, bank_reference=bank_result["bank_ref"], status=TxStatus.COMPLETED.value, provider_response=json.dumps(bank_result))
    db.add(movement); db.commit(); db.refresh(temp_tx)
    audit("real_withdraw_ok", uid=cu.id, req=req, detail=f"{payload.amount} {payload.currency} -> {payload.iban} [{bank_result['bank_ref']}] AI:{ai.profile_match_score}% is_real:{bank_result['is_real']}")
    return {"transaction": temp_tx, "ai_profile_check": ai, "bank_transfer": bank_result, "real_movement": movement}

@app.post("/api/transfers", response_model=dict, status_code=201)
def transfer(payload:TransferRequest, req:Request, cu:Annotated[User,Depends(current_user)], db:Annotated[Session,Depends(get_db)]):
    rate_limit(req)
    if payload.to_email==cu.email: raise HTTPException(status_code=400, detail="Kendine transfer yapamazsın")
    recipient=db.scalar(select(User).where(User.email==payload.to_email, User.status==UserStatus.ACTIVE.value))
    if not recipient: raise HTTPException(status_code=404, detail="Alıcı yok")
    q_sender=select(Account).where(Account.user_id==cu.id, Account.currency==payload.currency, Account.is_active.is_(True))
    if not DB_URL.startswith("sqlite"): q_sender=q_sender.with_for_update()
    sender_acc=db.scalar(q_sender)
    if not sender_acc: raise HTTPException(status_code=404, detail="Gönderen cüzdan yok")
    q_recv=select(Account).where(Account.user_id==recipient.id, Account.currency==payload.currency, Account.is_active.is_(True))
    if not DB_URL.startswith("sqlite"): q_recv=q_recv.with_for_update()
    recv_acc=db.scalar(q_recv)
    if not recv_acc: raise HTTPException(status_code=404, detail="Alıcı cüzdan yok")
    if Decimal(sender_acc.balance) < payload.amount: raise HTTPException(status_code=400, detail="Yetersiz bakiye")
    today_start=datetime.now(timezone.utc).replace(hour=0,minute=0,second=0,microsecond=0)
    today_out=db.scalars(select(Transaction.amount).where(Transaction.account_id==sender_acc.id, Transaction.type==TxType.TRANSFER_OUT.value, Transaction.created_at>=today_start)).all()
    total_today=sum([Decimal(str(a)) for a in today_out], Decimal("0"))
    if total_today + payload.amount > DAILY_LIMIT.get(payload.currency, MAX_AMT):
        raise HTTPException(status_code=400, detail=f"Günlük limit aşıldı: {DAILY_LIMIT[payload.currency]}")
    group_ref=f"TRF-{secrets.token_hex(8).upper()}"
    sender_acc.balance=quantize_amount(Decimal(sender_acc.balance)-payload.amount)
    recv_acc.balance=quantize_amount(Decimal(recv_acc.balance)+payload.amount)
    out_tx=Transaction(reference=f"OUT-{secrets.token_hex(10).upper()}", group_reference=group_ref, type=TxType.TRANSFER_OUT.value, account_id=sender_acc.id, counterparty_account_id=recv_acc.id, amount=payload.amount, currency=payload.currency, balance_after=sender_acc.balance, description=payload.description or f"{recipient.email} transfer", idempotency_key=payload.idempotency_key)
    in_tx=Transaction(reference=f"IN-{secrets.token_hex(10).upper()}", group_reference=group_ref, type=TxType.TRANSFER_IN.value, account_id=recv_acc.id, counterparty_account_id=sender_acc.id, amount=payload.amount, currency=payload.currency, balance_after=recv_acc.balance, description=payload.description or f"{cu.email} den transfer", idempotency_key=f"{payload.idempotency_key}-IN")
    db.add_all([out_tx, in_tx]); db.commit(); db.refresh(out_tx)
    ai = ai_verify_profile_match(db, cu, out_tx, req)
    audit("transfer_ok", uid=cu.id, req=req, detail=f"{payload.amount} -> {recipient.email} [{group_ref}] AI:{ai.profile_match_score}%")
    return {"transaction": out_tx, "ai_profile_check": ai, "group_ref": group_ref}

