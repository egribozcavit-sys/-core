class RegisterRequest(BaseModel):
    model_config = ConfigDict(extra="forbid", strict=True)
    email: str = Field(min_length=5, max_length=320)
    full_name: str = Field(min_length=2, max_length=160)
    password: str = Field(min_length=10, max_length=128)
    @field_validator("email")
    @classmethod
    def v_email(cls, v):
        if not re.match(r"^[^\s@]+@[^\s@]+\.[^\s@]+$", v): raise ValueError("Geçersiz email")
        return v.lower().strip()
    @field_validator("password")
    @classmethod
    def v_pass(cls, v):
        if not any(c.isdigit() for c in v): raise ValueError("En az bir rakam")
        if not any(c.isalpha() for c in v): raise ValueError("En az bir harf")
        if v.lower()==v: raise ValueError("En az bir büyük harf")
        return v

