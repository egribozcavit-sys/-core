@app.post("/api/auth/login")
def login(payload: LoginRequest, req: Request, db: Annotated[Session, Depends(get_db)]):
    rate_limit(req,"login",10,60)
    user=db.scalar(select(User).where(User.email==payload.email.lower()))
    if not user: raise HTTPException(status_code=401, detail="Hatalı")
    now=datetime.now(timezone.utc)
    lu=user.locked_until
    if lu:
        if lu.tzinfo is None: lu=lu.replace(tzinfo=timezone.utc)
        if lu>now: raise HTTPException(status_code=423, detail="Kilitli")
    if not verify_password(payload.password, user.password_hash):
        user.failed_login_attempts+=1
        if user.failed_login_attempts>=5: user.locked_until=now+timedelta(minutes=15)
        db.commit(); raise HTTPException(status_code=401, detail="Hatalı")
    user.failed_login_attempts=0; user.locked_until=None; db.commit()
    return {"access_token":create_access_token(user.id),"refresh_token":create_refresh_token(user.id),"kyc_status":user.kyc_status}

@app.post("/api/kyc/verify")
def kyc_verify(payload: KYCRequest, req: Request, cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)]):
    rate_limit(req,"kyc",3,3600)
    tc_hash=hashlib.sha256(payload.tc_no.encode()).hexdigest()
    existing=db.scalar(select(KYCVerification).where(KYCVerification.user_id==cu.id))
    is_valid=len(payload.tc_no)==11
    status_val=KYCStatus.VERIFIED.value if is_valid else KYCStatus.REJECTED.value
    if existing:
        existing.status=status_val; existing.tc_no_hash=tc_hash; existing.verified_at=utc_now() if is_valid else None
    else:
        db.add(KYCVerification(user_id=cu.id, tc_no_hash=tc_hash, status=status_val, verified_at=utc_now() if is_valid else None))
    if is_valid:
        cu.kyc_status=KYCStatus.VERIFIED.value; cu.status=UserStatus.ACTIVE.value
    db.commit()
    if not is_valid: raise HTTPException(status_code=400, detail="KYC reddedildi")
    return {"status":status_val}

