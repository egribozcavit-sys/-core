def quantize_amount(v: Any) -> Decimal:
    s = str(v).strip().lower().replace(',', '.')
    with localcontext() as ctx:
        ctx.prec=38; ctx.rounding=ROUND_HALF_UP
        return Decimal(s).quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP)

def generate_hmac(data: str, secret: str) -> str:
    return hmac.new(secret.encode(), data.encode(), hashlib.sha256).hexdigest()

def device_fp(req: Request) -> str:
    ua = req.headers.get("user-agent","")[:200]
