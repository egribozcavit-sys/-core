# 3) MODELLER
class UserStatus(str, Enum): ACTIVE="active"; SUSPENDED="suspended"; CLOSED="closed"
class TxType(str, Enum): DEPOSIT="deposit"; TRANSFER_OUT="transfer_out"; TRANSFER_IN="transfer_in"
class TxStatus(str, Enum): COMPLETED="completed"; FAILED="failed"

class User(Base):
    __tablename__="users"
    id: Mapped[str]=mapped_column(String(36), primary_key=True, default=uuid_str)
    email: Mapped[str]=mapped_column(String(320), unique=True, index=True)
    full_name: Mapped[str]=mapped_column(String(160))
    password_hash: Mapped[str]=mapped_column(String(500))
    status: Mapped[str]=mapped_column(String(20), default=UserStatus.ACTIVE.value, index=True)
    failed_login_attempts: Mapped[int]=mapped_column(Integer, default=0)
    locked_until: Mapped[Optional[datetime]]=mapped_column(DateTime(timezone=True), nullable=True)
    created_at: Mapped[datetime]=mapped_column(DateTime(timezone=True), default=utc_now)
    accounts: Mapped[List["Account"]]=relationship(back_populates="user", cascade="all, delete-orphan")

class Account(Base):
    __tablename__="accounts"
    id: Mapped[str]=mapped_column(String(36), primary_key=True, default=uuid_str)
    user_id: Mapped[str]=mapped_column(ForeignKey("users.id", ondelete="CASCADE"), index=True)
    currency: Mapped[str]=mapped_column(String(3), index=True)
    balance: Mapped[Decimal]=mapped_column(Numeric(20,2), default=Decimal("0.00"))
    is_active: Mapped[bool]=mapped_column(Boolean, default=True)
    created_at: Mapped[datetime]=mapped_column(DateTime(timezone=True), default=utc_now)
    user: Mapped[User]=relationship(back_populates="accounts")
    __table_args__=(UniqueConstraint("user_id","currency",name="uq_user_currency"), Index("ix_account_user_curr", "user_id","currency"))

class Transaction(Base):
    __tablename__="transactions"
    id: Mapped[str]=mapped_column(String(36), primary_key=True, default=uuid_str)
    reference: Mapped[str]=mapped_column(String(64), unique=True, index=True)
    group_reference: Mapped[Optional[str]]=mapped_column(String(64), index=True)
    type: Mapped[str]=mapped_column(String(20), index=True)
    status: Mapped[str]=mapped_column(String(20), default=TxStatus.COMPLETED.value, index=True)
    account_id: Mapped[str]=mapped_column(ForeignKey("accounts.id"), index=True)
    counterparty_account_id: Mapped[Optional[str]]=mapped_column(ForeignKey("accounts.id"), nullable=True)
    amount: Mapped[Decimal]=mapped_column(Numeric(20,2))
    currency: Mapped[str]=mapped_column(String(3), index=True)
    balance_after: Mapped[Decimal]=mapped_column(Numeric(20,2))
    description: Mapped[Optional[str]]=mapped_column(String(255), nullable=True)
    idempotency_key: Mapped[Optional[str]]=mapped_column(String(120), unique=True, index=True)
    created_at: Mapped[datetime]=mapped_column(DateTime(timezone=True), default=utc_now)
    completed_at: Mapped[Optional[datetime]]=mapped_column(DateTime(timezone=True), default=utc_now)

class AuditLog(Base):
    __tablename__="audit_logs"
