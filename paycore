@app.post("/api/transfers", response_model=TransactionResponse, status_code=201)
def transfer(payload:TransferRequest, req:Request, background_tasks: BackgroundTasks, cu:Annotated[User,Depends(current_user)], db:Annotated[Session,Depends(get_db)]):
    rate_limit(req); start=time.time()
    if payload.to_email.lower()==cu.email.lower(): raise HTTPException(status_code=400, detail="Kendine transfer yapamazsin")
    ex=db.scalar(select(Transaction).where(Transaction.user_id==cu.id, Transaction.idempotency_key==payload.idempotency_key))
    if ex: return ex
    recipient=db.scalar(select(User).where(User.email==payload.to_email.lower()))
    if not recipient: raise HTTPException(status_code=404, detail="Alici yok")
    sender_acc=db.scalar(select(Account).where(Account.user_id==cu.id, Account.currency==payload.currency, Account.is_active.is_(True)))
    recv_acc=db.scalar(select(Account).where(Account.user_id==recipient.id, Account.currency==payload.currency, Account.is_active.is_(True)))
    if not sender_acc or not recv_acc: raise HTTPException(status_code=404, detail="Cuzdan yok")
    if Decimal(sender_acc.balance) < payload.amount: raise HTTPException(status_code=400, detail="Yetersiz bakiye")
    today_start=datetime.now(timezone.utc).replace(hour=0,minute=0,second=0,microsecond=0)
    today_out=db.scalars(select(Transaction.amount).where(Transaction.account_id==sender_acc.id, Transaction.type==TxType.TRANSFER_OUT.value, Transaction.created_at>=today_start)).all()
    total_today=sum([Decimal(str(a)) for a in today_out], Decimal("0"))
    if total_today + payload.amount > DAILY_LIMIT.get(payload.currency, MAX_AMT): raise HTTPException(status_code=400, detail=f"Gunluk limit asildi {DAILY_LIMIT[payload.currency]}")
    fp=device_fp(req); geo=req.headers.get("CF-IPCountry","TR"); velocity=len(today_out)
    
    # V8.2 RISK ENGINE V2 - 4 faktörlü
    risk = risk_engine_v2(cu.id, payload.amount, fp, geo, total_today, velocity, db)
    
    if risk["risk_level"] == RiskLevel.CRITICAL.value or risk["geo_impossible"]:
        audit_hmac("transfer_blocked_v8_2_critical", uid=cu.id, req=req, detail=f"combined={risk['combined_score']} geo_impossible={risk['geo_impossible']} reasons={risk['reasons'][:2]}")
        raise HTTPException(status_code=403, detail=f"V8.2 BLOCKED CRITICAL: risk {risk['combined_score']} level {risk['risk_level']} | {risk['reasons'][0] if risk['reasons'] else 'critical risk'}")
    if risk["risk_level"] == RiskLevel.HIGH.value and risk["combined_score"] >= 75:
        audit_hmac("transfer_blocked_v8_2_high", uid=cu.id, req=req, detail=f"combined={risk['combined_score']} reasons={risk['reasons'][:2]}")
        raise HTTPException(status_code=403, detail=f"V8.2 BLOCKED HIGH: risk {risk['combined_score']} | {'; '.join(risk['reasons'][:2])}")
    
    group_ref=f"TRF-V82-{secrets.token_hex(8).upper()}"; elapsed=int((time.time()-start)*1000) or 1; multisig=payload.amount>=MULTISIG_THRESHOLD; token=secrets.token_hex(16)
    try:
        sender_acc.balance=quantize_amount(Decimal(sender_acc.balance)-payload.amount); recv_acc.balance=quantize_amount(Decimal(recv_acc.balance)+payload.amount)
        sender_acc.version+=1; recv_acc.version+=1
        out_tx=Transaction(
            reference=f"OUT-V82-{secrets.token_hex(10).upper()}", group_reference=group_ref, 
            type=TxType.TRANSFER_OUT.value if not multisig else TxType.MULTISIG.value, 
            status=TxStatus.COMPLETED.value, account_id=sender_acc.id, counterparty_account_id=recv_acc.id, 
            amount=payload.amount, currency=payload.currency, balance_after=sender_acc.balance, 
            user_id=cu.id, idempotency_key=payload.idempotency_key, 
            fraud_score=risk["fraud_score"], fraud_status=risk["fraud_status"],
            behavioral_score=risk["behavioral_score"], behavioral_status=risk["behavioral_status"],
            risk_score=risk["combined_score"], risk_level=risk["risk_level"],
            geo_velocity_score=risk["geo_velocity_score"], device_trust_score=risk["device_trust_score"],
            token=token, settlement_ms=elapsed, device_fp=fp, geo_country=geo, multisig_required=multisig, description=payload.description
        )
        in_tx=Transaction(
            reference=f"IN-V82-{secrets.token_hex(10).upper()}", group_reference=group_ref, 
            type=TxType.TRANSFER_IN.value, status=TxStatus.COMPLETED.value, 
            account_id=recv_acc.id, counterparty_account_id=sender_acc.id, 
            amount=payload.amount, currency=payload.currency, balance_after=recv_acc.balance, 
            user_id=recipient.id, idempotency_key=f"{payload.idempotency_key}-IN", 
            fraud_score=risk["combined_score"], fraud_status=risk["fraud_status"],
            behavioral_score=risk["behavioral_score"], behavioral_status=risk["behavioral_status"],
            risk_score=risk["combined_score"], risk_level=risk["risk_level"],
            geo_velocity_score=risk["geo_velocity_score"], device_trust_score=risk["device_trust_score"],
            token=token, settlement_ms=elapsed, device_fp=fp, geo_country=geo, multisig_required=multisig
        )
        db.add_all([out_tx, in_tx]); db.commit(); db.refresh(out_tx)
        
        # Risk log
        risk_log = RiskEngineLog(
            user_id=cu.id, transaction_id=out_tx.id,
            fraud_score=risk["fraud_score"], behavioral_score=risk["behavioral_score"],
            geo_velocity_score=risk["geo_velocity_score"], device_trust_score=risk["device_trust_score"],
            combined_risk_score=risk["combined_score"], risk_level=risk["risk_level"],
            reasons=json.dumps(risk["reasons"][:5])
        )
        db.add(risk_log)
        
        # Behavioral alert
        if risk["behavioral_score"] >= 30 and risk["behavioral_detail"]:
            bd = risk["behavioral_detail"]
            alert=BehavioralAlert(
                user_id=cu.id, transaction_id=out_tx.id,
                reason="; ".join(bd["reasons"])[:500],
                baseline_count=bd["baseline"]["avg_daily_count"],
                current_count=bd.get("today_count", 1),
                baseline_amount=bd["baseline"]["avg_amount"],
                current_amount=payload.amount,
                behavioral_score=risk["behavioral_score"],
                risk_level=risk["risk_level"]
            )
            db.add(alert)
        
        # Geo velocity log if impossible
        if risk["geo_impossible"] and risk["geo_detail"]:
            gd = risk["geo_detail"]
            gv = GeoVelocityLog(
                user_id=cu.id, from_geo=gd["from"], to_geo=gd["to"],
                time_diff_seconds=gd["time_diff_s"], distance_km=gd.get("distance_km",8000),
                is_impossible=True
            )
            db.add(gv)
        
        # Device trust update
        dt = db.scalar(select(DeviceTrust).where(DeviceTrust.user_id==cu.id, DeviceTrust.device_fp==fp))
        if dt:
            dt.tx_count += 1
            dt.last_seen = utc_now()
            dt.trust_score = min(95, dt.trust_score + 1)
            if dt.tx_count > 10:
                dt.is_trusted = True
        else:
            db.add(DeviceTrust(user_id=cu.id, device_fp=fp, trust_score=50, tx_count=1, is_trusted=False))
        
        db.commit()
        
        if multisig:
            msr=MultiSigRequest(transaction_id=out_tx.id, requester_id=cu.id, status="pending")
            db.add(msr); db.commit()
    except IntegrityError:
        db.rollback()
        dup=db.scalar(select(Transaction).where(Transaction.idempotency_key==payload.idempotency_key))
        if dup: return dup
        raise HTTPException(status_code=409, detail="Cakisma V8.2")
    
    audit_hmac("transfer_ok_v8_2", uid=cu.id, req=req, detail=f"{payload.amount} {payload.currency} -> {payload.to_email} risk={risk['combined_score']} level={risk['risk_level']} token={token} ms={elapsed}")
    ob=Outbox(aggregate_id=out_tx.id, event_type="transfer.completed.v8.2", payload=json.dumps({"amount":str(payload.amount),"currency":payload.currency,"token":token,"risk_score":risk["combined_score"],"risk_level":risk["risk_level"],"settlement_ms":elapsed}), webhook_url="https://example.com/webhook")
    db.add(ob); db.commit()
    background_tasks.add_task(send_webhook_background, ob.id)
    return out_tx

