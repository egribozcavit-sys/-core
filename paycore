    analysis = AIAnalysisV5(transaction_id=tx.id, user_id=user.id, is_real_owner=is_real, profile_match_score=match_score, actor_type=actor, threat_level=threat, risk_score=min(risk,100.0), confidence=95.0 if is_real else 88.0, reasoning=" | ".join(reasoning) if reasoning else "Profil %100 uyuşuyor", signals=" | ".join(signals), ip_address=ip, user_agent=ua, device_fingerprint=fingerprint, location_hint="TR", is_anomaly=is_anomaly)
