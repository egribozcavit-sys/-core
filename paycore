@app.post("/api/auth/login")
def login(payload: LoginRequest, req: Request, db: Annotated[Session, Depends(get_db)]):
    rate_limit(req, key="login", limit=20, window=60)
    user=db.scalar(select(User).where(User.email==payload.email.lower()))
    if not user: raise HTTPException(status_code=401, detail="Gecersiz")
    if user.locked_until and user.locked_until.replace(tzinfo=timezone.utc) > utc_now(): raise HTTPException(status_code=423, detail="Kilitli")
    if not verify_password(payload.password, user.password_hash):
        user.failed_login_attempts+=1
        if user.failed_login_attempts>=MAX_FAIL: user.locked_until=utc_now()+timedelta(minutes=LOCK_MIN)
        db.commit(); raise HTTPException(status_code=401, detail="Gecersiz")
    user.failed_login_attempts=0; user.locked_until=None; user.device_fingerprint=device_fp(req); db.commit()
    audit_hmac("login_ok", uid=user.id, req=req)
    return {"access_token":create_access_token(user.id),"refresh_token":create_refresh_token(user.id),"expires_in":ACCESS_MIN*60,"v8_1_ultra":True,"satir":1200}

@app.post("/api/auth/refresh")
def refresh(db: Annotated[Session, Depends(get_db)], x_refresh_token: Annotated[Optional[str], Header(alias="X-Refresh-Token")]=None):
    if not x_refresh_token: raise HTTPException(status_code=401, detail="Refresh gerekli")
    try: p=jwt.decode(x_refresh_token, JWT_SECRET, algorithms=[JWT_ALG])
    except JWTError: raise HTTPException(status_code=401, detail="Gecersiz refresh")
    if p.get("type")!="refresh": raise HTTPException(status_code=401, detail="Gecersiz tip")
    if is_jti_revoked(db, p.get("jti","")): raise HTTPException(status_code=401, detail="Iptal edilmis")
    user=db.get(User, p.get("sub"))
    if not user: raise HTTPException(status_code=401, detail="Kullanici yok")
    if not revoke_jti(db, p.get("jti",""), user.id, p.get("exp")): raise HTTPException(status_code=401, detail="Zaten kullanilmis")
    return {"access_token":create_access_token(user.id),"refresh_token":create_refresh_token(user.id),"expires_in":ACCESS_MIN*60,"satir":1200}

@app.post("/api/auth/logout")
def logout(cu: Annotated[User, Depends(current_user)], db: Annotated[Session, Depends(get_db)], creds: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)]=None, x_refresh_token: Annotated[Optional[str], Header(alias="X-Refresh-Token")]=None):
    for tok in [creds.credentials if creds else None, x_refresh_token]:
        if not tok: continue
        try:
            p=jwt.decode(tok, JWT_SECRET, algorithms=[JWT_ALG], options={"verify_exp":False})
            if p.get("sub")!=cu.id: continue
            revoke_jti(db, p.get("jti",""), cu.id, p.get("exp"))
        except: continue
    audit_hmac("logout", uid=cu.id); return {"message":"Cikis yapildi","satir":1200}

