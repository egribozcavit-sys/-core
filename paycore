bearer_scheme = HTTPBearer(auto_error=False)
rate_store: Dict[str, List[float]] = {}
rate_lock = threading.Lock()
def rate_limit(req: Request):
    ip = req.client.host if req.client else "unknown"
    now = time.time()
    with rate_lock:
        lst = rate_store.get(ip, [])
        lst = [t for t in lst if now - t < 60]
        if len(lst) >= RATE_REQ: raise HTTPException(status_code=429, detail="Çok fazla istek")
        lst.append(now); rate_store[ip]=lst
def get_db():
    db = SessionLocal()
    try: yield db
    finally: db.close()
def create_access_token(uid: str):
    jti = secrets.token_hex(16); exp = utc_now() + timedelta(minutes=ACCESS_MIN)
    return jwt.encode({"sub": uid, "jti": jti, "exp": exp, "type": "access"}, JWT_SECRET, algorithm=JWT_ALG)
def create_refresh_token(uid: str):
    jti = secrets.token_hex(16); exp = utc_now() + timedelta(days=REFRESH_DAYS)
    return jwt.encode({"sub": uid, "jti": jti, "exp": exp, "type": "refresh"}, JWT_SECRET, algorithm=JWT_ALG)
def is_jti_revoked(db: Session, jti: str): return db.get(RevokedToken, jti) is not None
def revoke_jti(db: Session, jti: str, uid: str, exp_ts):
    try: exp = datetime.fromtimestamp(exp_ts, tz=timezone.utc) if isinstance(exp_ts, (int,float)) else utc_now()+timedelta(days=REFRESH_DAYS)
    except: exp = utc_now()+timedelta(days=REFRESH_DAYS)
    if not is_jti_revoked(db, jti):
        db.add(RevokedToken(jti=jti, user_id=uid, expires_at=exp)); db.commit()
def audit(action: str, uid: Optional[str]=None, req: Optional[Request]=None, detail: Optional[str]=None):
    try:
        db = SessionLocal()
        ip = req.client.host if req and req.client else None
        ua = req.headers.get("user-agent") if req else None
        db.add(AuditLog(user_id=uid, action=action, ip_address=ip, user_agent=ua, detail=detail))
        db.commit(); db.close()
    except: pass
def current_user(credentials: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)], db: Annotated[Session, Depends(get_db)]):
    if not credentials: raise HTTPException(status_code=401, detail="Token gerekli")
    try:
        payload = jwt.decode(credentials.credentials, JWT_SECRET, algorithms=[JWT_ALG])
        if payload.get("type")!="access": raise HTTPException(status_code=401, detail="Geçersiz token")
        if is_jti_revoked(db, payload.get("jti","")): raise HTTPException(status_code=401, detail="Token iptal")
        uid = payload.get("sub"); user = db.get(User, uid)
        if not user or user.status!=UserStatus.ACTIVE.value: raise HTTPException(status_code=401, detail="Kullanıcı yok")
        if user.locked_until and user.locked_until>utc_now(): raise HTTPException(status_code=423, detail="Hesap kilitli")
        return user
    except JWTError: raise HTTPException(status_code=401, detail="Geçersiz token")

def build_or_update_profile(db: Session, user: User, tx: Transaction, req: Request):
    profile = db.get(UserBehaviorProfile, user.id)
    if not profile:
        profile = UserBehaviorProfile(user_id=user.id, typical_ips="[]", typical_uas="[]", typical_hours="[]", avg_amount=float(tx.amount), total_tx_count=1)
        db.add(profile); db.commit(); db.refresh(profile)
        return profile
    try: ips = json.loads(profile.typical_ips)
    except: ips=[]
    try: uas = json.loads(profile.typical_uas)
    except: uas=[]
    try: hours = json.loads(profile.typical_hours)
    except: hours=[]
    ip = req.client.host if req.client else "unknown"
    ua = req.headers.get("user-agent","unknown")[:100]
    hour = utc_now().hour
    if ip not in ips: ips.append(ip); ips=ips[-20:]
    if ua not in uas: uas.append(ua); uas=uas[-10:]
    if hour not in hours: hours.append(hour)
    new_avg = (profile.avg_amount * profile.total_tx_count + float(tx.amount)) / (profile.total_tx_count+1)
    profile.typical_ips=json.dumps(ips); profile.typical_uas=json.dumps(uas); profile.typical_hours=json.dumps(hours)
    profile.avg_amount=new_avg; profile.total_tx_count+=1; profile.last_updated=utc_now()
    db.commit(); db.refresh(profile)
    return profile

