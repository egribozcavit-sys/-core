rate_store: Dict[str, List[float]]={}
rate_lock=threading.Lock()
def rate_limit(req: Request, key: str="global", limit: int=RATE_REQ, window: int=RATE_WIN):
    ip=req.client.host if req.client else "unknown"
    rkey=f"rl:{key}:{ip}"
    now=time.time()
    if REDIS_ENABLED:
        try:
            pipe=redis_client.pipeline()
            pipe.zremrangebyscore(rkey, 0, now-window)
            pipe.zcard(rkey)
            pipe.zadd(rkey, {str(uuid.uuid4()): now})
            pipe.expire(rkey, window)
            _, count, _, _=pipe.execute()
            if count>=limit: raise HTTPException(status_code=429, detail="Rate limit Redis V8.2")
            return
        except HTTPException: raise
        except: pass
    with rate_lock:
        lst=[t for t in rate_store.get(rkey,[]) if now-t<window]
        if len(lst)>=limit: raise HTTPException(status_code=429, detail="Rate limit V8.2")
        lst.append(now); rate_store[rkey]=lst

