bearer_scheme=HTTPBearer(auto_error=False)
rate_store: Dict[str, List[float]]={}; rate_lock=threading.Lock()
def rate_limit(req: Request):
    ip=req.client.host if req.client else "unknown"; now=time.time()
    with rate_lock:
        lst=[t for t in rate_store.get(ip,[]) if now-t < 60]
        if len(lst)>=60: raise HTTPException(status_code=429, detail="Çok fazla istek", headers={"Retry-After":"60"})
        lst.append(now); rate_store[ip]=lst

def get_db():
    db=SessionLocal()
    try: yield db
    finally: db.close()

def create_token(uid: str, typ: str, delta: timedelta)->str:
    now=datetime.now(timezone.utc)
    payload={"sub":uid, "type":typ, "iat":int(now.timestamp()), "exp":int((now+delta).timestamp()), "jti":secrets.token_urlsafe(24)}
    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALG)

def create_access_token(uid: str): return create_token(uid, "access", timedelta(minutes=ACCESS_MIN))
def create_refresh_token(uid: str): return create_token(uid, "refresh", timedelta(days=REFRESH_DAYS))
def is_jti_revoked(db: Session, jti: str)->bool: return db.get(RevokedToken, jti) is not None

def current_user(creds: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)], db: Annotated[Session, Depends(get_db)]):
    if not creds: raise HTTPException(status_code=401, detail="Auth gerekli", headers={"WWW-Authenticate":"Bearer"})
    try: payload=jwt.decode(creds.credentials, JWT_SECRET, algorithms=[JWT_ALG])
    except JWTError: raise HTTPException(status_code=401, detail="Geçersiz token", headers={"WWW-Authenticate":"Bearer"})
    if payload.get("type")!="access": raise HTTPException(status_code=401, detail="Geçersiz access token")
    if is_jti_revoked(db, payload.get("jti","")): raise HTTPException(status_code=401, detail="Oturum iptal")
    user=db.get(User, payload.get("sub"))
    if not user or user.status!=UserStatus.ACTIVE.value: raise HTTPException(status_code=401, detail="Kullanıcı yok")
    return user

def audit(action: str, uid: Optional[str]=None, req: Optional[Request]=None, detail: Optional[str]=None):
    try:
        with SessionLocal() as adb:
            safe_detail = re.sub(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", "***@***", detail)[:500] if detail else None
            adb.add(AuditLog(user_id=uid or "system", action=action, ip_address=req.client.host if req and req.client else None, detail=safe_detail)); adb.commit()
    except: pass

