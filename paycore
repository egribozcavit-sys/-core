bearer_scheme=HTTPBearer(auto_error=False)
def get_db():
    db=SessionLocal()
    try: yield db
    finally: db.close()
def create_token(uid: str, typ: str, delta: timedelta)->str:
    now=datetime.now(timezone.utc)
    payload={"sub":uid,"type":typ,"iat":int(now.timestamp()),"exp":int((now+delta).timestamp()),"jti":secrets.token_urlsafe(24),"iss":APP_NAME}
    return jwt.encode(payload, JWT_SECRET, algorithm=JWT_ALG)
def create_access_token(uid: str): return create_token(uid,"access",timedelta(minutes=ACCESS_MIN))
def create_refresh_token(uid: str): return create_token(uid,"refresh",timedelta(days=REFRESH_DAYS))
def is_jti_revoked(db: Session, jti: str)->bool: return db.get(RevokedToken, jti) is not None
def current_user(creds: Annotated[Optional[HTTPAuthorizationCredentials], Depends(bearer_scheme)], db: Annotated[Session, Depends(get_db)]):
    if not creds: raise HTTPException(status_code=401, detail="Auth gerekli")
    try: payload=jwt.decode(creds.credentials, JWT_SECRET, algorithms=[JWT_ALG])
    except JWTError: raise HTTPException(status_code=401, detail="Geçersiz token")
    if payload.get("type")!="access": raise HTTPException(status_code=401, detail="Geçersiz access")
    if is_jti_revoked(db, payload.get("jti","")): raise HTTPException(status_code=401, detail="Oturum iptal")
    user=db.get(User, payload.get("sub"))
    if not user or user.status==UserStatus.CLOSED.value: raise HTTPException(status_code=401, detail="Kullanıcı yok")
    return user
def require_kyc(user: User):
    if user.kyc_status!=KYCStatus.VERIFIED.value: raise HTTPException(status_code=403, detail="KYC gerekli")
def aml_check(amount: Decimal, currency: str)->bool:
    if currency=="USD" and amount>=Decimal("10000"): return False
    if currency=="TRY" and amount>=Decimal("185000"): return False
    return True
def fraud_check(db: Session, account_id: str):
    one_min_ago=datetime.now(timezone.utc)-timedelta(minutes=1)
    count=db.scalar(select(func.count()).select_from(Transaction).where(Transaction.account_id==account_id, Transaction.created_at>=one_min_ago)) or 0
    if count>=10: return FraudStatus.BLOCKED
    if count>=5: return FraudStatus.FLAGGED
    return FraudStatus.CLEAN
def audit(action: str, uid: Optional[str]=None, req: Optional[Request]=None, detail: Optional[str]=None):
    try:
        with SessionLocal() as adb:
            safe=re.sub(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}", "***@***", detail)[:500] if detail else None
            adb.add(AuditLog(user_id=uid or "system", action=action, ip_address=req.client.host if req and req.client else None, detail=safe))
            adb.commit()
    except: pass

