APP_NAME=PayCore
APP_VERSION=1.0.0
DEBUG=false

SECRET_KEY=your-super-secret-key-min-32-chars-change-this-in-production

DATABASE_URL=postgresql://user:pass@localhost:5432/paycore
REDIS_URL=redis://localhost:6379/0

REDIS_STREAM_NAME=paycore:transactions
REDIS_CONSUMER_GROUP=paycore-workers

MAX_WORKERS=4
DB_POOL_SIZE=20
REDIS_POOL_SIZE=10
BATCH_SIZE=100

RATE_LIMIT_PER_MINUTE=1000
CORS_ORIGINS=["*"]
